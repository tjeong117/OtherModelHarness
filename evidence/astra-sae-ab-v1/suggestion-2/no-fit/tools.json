            "minLength": 1,
            "maxLength": 512
          },
          "selection": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1099511627776
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            },
            "minItems": 0,
            "maxItems": 12
          },
          "mode": {
            "enum": [
              "ref",
              "summary",
              "values"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1099511627776
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "additionalProperties": false
      }
    }
