            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1099511627776
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "description": "Ordered next-token IDs [wanted, alternative]. The margin is their logit difference."
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layer": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1024
