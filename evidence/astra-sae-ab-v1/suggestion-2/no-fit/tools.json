  {
    "type": "function",
    "function": {
      "name": "patch_activations",
      "description": "Temporarily replace one target activation at a time with the matched source activation. Rank tested sites by their measured effect on the target next-token margin. Positions index rendered prompt tokens and default to -1.",
      "parameters": {
        "type": "object",
        "properties": {
          "source_prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
