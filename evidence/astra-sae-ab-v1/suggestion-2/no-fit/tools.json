  {
    "type": "function",
    "function": {
      "name": "run_target",
      "description": "Generate greedily on public prompts. Attach an optional block-output probe to this live run. An SAE intervention runs a baseline and a temporary counterfactual. Position -1 observes the last input token. Omit positions to use [-1].",
      "parameters": {
        "type": "object",
        "properties": {
          "prompts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            },
            "minItems": 1,
            "maxItems": 8
          },
          "max_new_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "probe": {
            "type": "object",
            "properties": {
              "layer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1024
              },
              "kind": {
                "enum": [
                  "residual",
                  "sae"
                ]
              },
              "positions": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 1,
                "maxItems": 16
              },
              "top_k": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "phase": {
                "enum": [
                  "prefill",
                  "each_step"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "if": {
              "properties": {
                "kind": {
                  "const": "residual"
                }
              }
            },
            "then": {
              "required": [
                "layer"
              ]
            },
            "description": "For an SAE probe omit layer to use the loaded dictionary. Residual probes require a block index."
          },
          "intervention": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "feature": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  "scale": {
                    "type": "number"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "feature"
                ],
                "oneOf": [
                  {
                    "required": [
                      "scale"
                    ]
                  },
                  {
                    "required": [
                      "value"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "prompts"
        ]
      }
    }
  },
